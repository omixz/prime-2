# Copy this file's contents into Vercel's Environment Variables settings.
# Never commit a real .env file with actual secrets to GitHub.

# Square (Settings > Developer > API Keys in your Square Dashboard)
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_LOCATION_ID=your-square-location-id
SQUARE_ENVIRONMENT=sandbox
# ^ set to "production" only when you're ready to accept real payments

# The full public URL of your deployed site (no trailing slash)
SITE_URL=https://your-site.vercel.app

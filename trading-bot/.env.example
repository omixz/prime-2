# Copy to .env and fill in. Never commit a real .env file.

# Alpaca API keys — https://app.alpaca.markets (paper) or https://alpaca.markets (live)
ALPACA_API_KEY=your-key-id
ALPACA_SECRET_KEY=your-secret-key

# "true" = paper trading (fake money, real market data). Keep this true until you
# have watched the bot run correctly for at least a few full trading days.
ALPACA_PAPER=true

# Optional: Slack/Discord incoming webhook URL for alerts (kill-switch trips,
# crashes, daily summary). Leave blank to disable.
ALERT_WEBHOOK_URL=

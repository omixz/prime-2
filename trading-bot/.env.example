# Copy to .env and fill in. Never commit a real .env file.

# Binance API keys.
# Testnet keys (fake funds): log into https://testnet.binance.vision with GitHub.
# Live keys: https://www.binance.com/en/my/settings/api-management (requires
# Intermediate verification — government photo ID, no proof of address needed).
BINANCE_API_KEY=your-key
BINANCE_API_SECRET=your-secret

# "true" = testnet (fake funds, real market data). Keep this true until you
# have watched the bot run correctly for at least a few full days.
BINANCE_TESTNET=true

# Optional: Slack/Discord incoming webhook URL for alerts (kill-switch trips,
# crashes, daily summary). Leave blank to disable.
ALERT_WEBHOOK_URL=
